# 可选：云端相机角度控制（Modal）endpoint
# 部署 modal/camera_angle.py 后，把生成的 endpoint 填到这里
# 留空时前端会走本地 /api/camera-angle 接口
VITE_MODAL_CAMERA_ENDPOINT=
