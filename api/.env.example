# ============================================================
# video-api 后端环境变量模板
# 使用方法：复制本文件为 .env，然后填入真实 API Key
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交真实密钥到仓库
# ============================================================

# --- 服务端口（前端 vite 代理默认指向 8024） ---
PORT=8024
NODE_ENV=development

# --- Google Gemini / Veo（默认模型，必填） ---
# 获取：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- 可灵 Kling（图片 + 视频） ---
# 获取：https://app.klingai.com/global/dev/api-key
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- MiniMax Hailuo（视频） ---
HAILUO_API_KEY=

# --- OpenAI GPT Image ---
OPENAI_API_KEY=

# --- Fal.ai（Kling V2.6 动作控制） ---
FAL_API_KEY=

# --- 火山豆包 Seedance（视频生成） ---
SEEDANCE_API_KEY=
SEEDANCE_MODEL_ID=doubao-seedance-2-0-260128
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 火山豆包 VLM（聊天助手） ---
VLM_DOUBAO_API_KEY=
VLM_DOUBAO_MODEL_ID=ep-m-20260731200545-vdkh5
VLM_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 火山方舟 DeepSeek（剧本智能解析） ---
DRAMA_API_KEY=
DRAMA_MODEL_ID=deepseek-v4-flash-ga-260731
DRAMA_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 火山豆包 Seedream（图片生成） ---
SEEDREAM_API_KEY=
SEEDREAM_MODEL_ID=ep-20260804162342-5vczp
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 火山引擎豆包语音 TTS（语音合成 / 配音） ---
# 注意：这是「语音技术」服务，和上面的方舟（Ark）模型 Key 相互独立、不通用！
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_CLUSTER=volcano_tts

# ============================================================
# 多 key / 三通道配置（可选，用于分摊并发、按模块隔离）
# 三个通道：free（自由画布）/ project（项目画布）/ workflow（工作流）
#   1) 多把 key（逗号分隔）：DRAMA_API_KEYS=key1,key2,key3
#   2) 通道专属 key：DRAMA_API_KEY_WORKFLOW=keyA
#   3) 数字下标：SEEDANCE_API_KEY_1=key1
# 并发队列默认每通道每模型 3 并发，可用 CHANNEL_MAX_CONCURRENT 调整。
# ============================================================
CHANNEL_MAX_CONCURRENT=3

# --- 飞书登录（OAuth） ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8025/auth/callback
# 可选：公司（企业）标识 tenant_key。留空时首个登录用户所属企业自动锁定为本公司。
FEISHU_TENANT_KEY=
COMPANY_NAME=
# 生产环境务必修改，否则使用默认开发密钥
JWT_SECRET=

# --- 数据目录（可选，默认 ./library） ---
# LIBRARY_DIR=./library

# --- 本地模型（可选） ---
# LOCAL_MODELS_DIR=./models
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1

# --- 可选：发布到 X (Twitter) ---
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_CALLBACK_URL=http://127.0.0.1:8024/api/twitter/callback

# --- 可选：发布到 TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=

# ============================================================
# PostgreSQL（业务数据持久化，取代 library/*.json）
# ============================================================
# 优先级：DATABASE_URL 非空时优先使用；留空则回落到下方 PGHOST/PGPORT/... 分项配置
# 格式：postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=

# --- 分项配置（DATABASE_URL 留空时生效） ---
# 本机 PostgreSQL（服务 postgresql-x64-18），端口 5432，库名 video_workflow。
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=video_workflow
PGUSER=postgres
PGPASSWORD=
# 云数据库（阿里云 RDS / Supabase / Neon 等）一般为 true
PGSSL=false

# --- 连接池 ---
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=0

# --- 数据层开关 ---
# file = 继续读写 library/*.json（当前行为，默认）
# db   = 全部走 PostgreSQL
# dual = 双写过渡：以 PG 为准写入，同时保留文件副本
DB_DRIVER=file

# --- 迁移 ---
DB_AUTO_MIGRATE=true
DB_IMPORT_LEGACY=false
